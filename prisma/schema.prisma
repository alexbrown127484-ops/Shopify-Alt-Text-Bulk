generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model BulkUpdateJob {
  id                  String    @id @default(cuid())
  shop                String
  status              String
  productCursor       String?
  collectionCursor    String?
  productsDone        Boolean   @default(false)
  collectionsDone     Boolean   @default(false)
  productsUpdated     Int       @default(0)
  collectionsUpdated  Int       @default(0)
  productsScanned     Int       @default(0)
  collectionsScanned  Int       @default(0)
  totalProducts       Int       @default(0)
  totalCollections    Int       @default(0)
  startedAt           DateTime  @default(now())
  lastHeartbeatAt     DateTime  @default(now())
  leaseExpiresAt      DateTime?
  finishedAt          DateTime?
  errorMessage        String?

  @@index([shop, status])
  @@index([shop, startedAt])
}

